    "compilerOptions": {
        "checkJs": true,
        "module": "commonjs",
        "target": "es2022",
        "lib": ["es2022", "dom"],
        "moduleResolution": "node",
        "noEmit": true,
        "strict": false,
        "skipLibCheck": true
    },
    "include": ["server.js", "public/**/*.js", "test/**/*.js"]
}
